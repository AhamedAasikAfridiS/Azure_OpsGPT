APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8003

DATABASE_URL=postgresql://opsgpt_analysis:opsgpt_analysis_password@analysis-db:5432/opsgpt_analysis_db
CORE_API_URL=http://core-api-service:8001
INTERNAL_API_KEY=change-me-internal-key
CORRELATION_WINDOW_MINUTES=10
AI_PROVIDER=ollama

# The default below is for Docker Compose.
# Change it to http://localhost:11434 when running this service on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

CORS_ORIGINS=http://localhost:3000
