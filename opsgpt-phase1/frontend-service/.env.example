# Browser requests use the host-published Core API port.
VITE_CORE_API_URL=http://localhost:8001
VITE_ALERT_INGESTION_URL=http://localhost:8002

# VM browser access:
# Replace localhost with the VM public or private IP because browser requests
# originate from the user's machine, not from inside the Docker network.
# VITE_CORE_API_URL=http://<VM_PUBLIC_OR_PRIVATE_IP>:8001
# VITE_ALERT_INGESTION_URL=http://<VM_PUBLIC_OR_PRIVATE_IP>:8002
