# OpsGPT root Docker Compose environment
# Fill real Azure values locally. Do not commit real secrets to source control.

# Authentication mode
AUTH_PROVIDER=entra
ALLOW_LOCAL_AUTH=false

# Microsoft Entra ID - Core API token validation
AZURE_TENANT_ID=c447992a-5d19-45c6-8d2d-52f2c4969890
AZURE_CLIENT_ID=114ce36f-0885-4638-aad9-ddaf7196e819
AZURE_API_AUDIENCE=api://114ce36f-0885-4638-aad9-ddaf7196e819
AZURE_ISSUER=https://sts.windows.net/c447992a-5d19-45c6-8d2d-52f2c4969890/
AZURE_JWKS_URL=https://login.microsoftonline.com/c447992a-5d19-45c6-8d2d-52f2c4969890/discovery/v2.0/keys

# Microsoft Entra app role values
ENTRA_ROLE_ADMIN=OpsGPT.Admin
ENTRA_ROLE_SENIOR=OpsGPT.Senior
ENTRA_ROLE_JUNIOR=OpsGPT.Junior

# Frontend MSAL / Vite build-time configuration
VITE_CORE_API_URL=/api/core
VITE_AUTH_PROVIDER=entra
VITE_AZURE_TENANT_ID=c447992a-5d19-45c6-8d2d-52f2c4969890
VITE_AZURE_CLIENT_ID=d6ada247-c840-4242-be7d-e4e7c4d12b73
VITE_AZURE_REDIRECT_URI=http://localhost:8080
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:8080
VITE_AZURE_API_SCOPE=api://114ce36f-0885-4638-aad9-ddaf7196e819/access_as_user

# Azure AI Foundry / Microsoft Foundry for ai-analysis-service
AZURE_FOUNDRY_ENDPOINT=https://ahamedaasik-ai-foundry.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=3eNLGbN21oEdIOH0J5F7Y39dnPURCrqdJyjjGkFRWEURWWfNofQtJQQJ99CFACi0881XJ3w3AAAAACOGqXvU
AZURE_FOUNDRY_MODEL=gpt-5.3-codex
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview

# Local fallback option:
# To use seeded local users instead of Entra for development, set:
# AUTH_PROVIDER=local
# ALLOW_LOCAL_AUTH=true
# VITE_AUTH_PROVIDER=local
